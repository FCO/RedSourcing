use Test;
use RedSourcing;
use RedSourcing::Inspector;
use RedSourcing::Config;
use Red::DB;
use RedSourcing::Web::Metrics;
use RedSourcing::Web::Charts;

my $*RED-DB;
my $database = %*ENV<RED_SOURCING_TEST_PG_DATABASE>;
my $admin;
my $schema = 'rs_metrics_' ~ $*PID;
LEAVE $admin.execute("DROP SCHEMA $schema CASCADE") if $admin.defined;
if $database.defined {
    die 'Use a simple database name' unless $database ~~ /^ <[\w\-]>+ $/;
    require ::('DB::Pg');
    $admin = ::('DB::Pg').new(:conninfo("dbname=$database"));
    $admin.execute("CREATE SCHEMA $schema");
    my $pool = ::('DB::Pg').new(:conninfo("dbname=$database options='-csearch_path=$schema -cclient_min_messages=warning'"),
        :converters(<DateTime UUID Geometric>));
    $*RED-DB = store-driver('Pg', $database, :connection{ dbh => $pool });
} else { $*RED-DB = store-driver('SQLite', ':memory:') }
red-sourcing-defaults;
my $now = DateTime.new('2026-10-11T12:05:20Z');
my @instances = %(stream => 'account/a', type => 'Account', kind => 'aggregate'),
    %(stream => 'Saga: id = a', type => 'Saga', kind => 'saga');
sub emit-row(Str $class, Str $stream, UInt $version, Str $mro, %data, Int $seconds) {
    StoredEvent.^create(:$class, :$stream, :$version, :$mro, :data(%data), :created($now.earlier(:$seconds)))
}
emit-row('Account', 'account/a', 1, '|Entity|', %(amount => 0), 300);
emit-row('Deposit', 'account/a', 2, '|Event|', %(amount => 1), 80);
emit-row('Account', 'account/a', 3, '|Entity|', %(amount => 1), 60);
emit-row('Deposit', 'account/a', 4, '|Event|', %(amount => 1), 5);
sub state(UInt $attempts, Str $status) {
    %(status => 'running', actions => [%(id => 'action/1', attempts => $attempts, :$status).item],
        timers => {}, compensations => [])
}
emit-row('RedSourcing::Saga::StateChanged', 'Saga: id = a', 1, '|RedSourcing::Saga::Control|',
    %(state => state(1, 'running'), values => {}, cursor => 2), 80);
emit-row('RedSourcing::Saga::StateChanged', 'Saga: id = a', 2, '|RedSourcing::Saga::Control|',
    %(state => state(1, 'retry'), values => {}, cursor => 2), 75);
emit-row('RedSourcing::Saga::StateChanged', 'Saga: id = a', 3, '|RedSourcing::Saga::Control|',
    %(state => state(2, 'running'), values => {}, cursor => 2), 40);
emit-row('RedSourcing::Saga::StepFailed', 'Saga: id = a', 4, '|RedSourcing::Saga::Control|',
    %(state => state(2, 'blocked'), values => {}, cursor => 2, action-id => 'action/1'), 30);
emit-row('Saga', 'Saga: id = a', 5, '|Entity|', %(saga-state => state(2, 'blocked')), 20);
StoredCommand.^create(:stream<account/a>, :entity<Account>, :entity-ids{ :id<a> },
    :method<deposit>, :class<Deposit>, :state(StoredCommand::Failed), :tries(1), :error<Rejected>, :data{});
StoredCommand.^create(:stream<account/a>, :entity<Account>, :entity-ids{ :id<a> },
    :method<deposit>, :class<Deposit>, :state(StoredCommand::Pending), :data{});
StoredCommand.^create(:stream<account/a>, :entity<Account>, :entity-ids{ :id<a> },
    :method<deposit>, :class<Deposit>, :state(StoredCommand::Processing), :tries(3), :data{});
my %m = store-metrics(:@instances, :minutes(3), :$now);
is %m<series>.elems, 3, 'minute buckets include idle minutes';
is %m<totals><events>, 2, 'domain events exclude snapshots and controls';
is %m<totals><snapshots>, 3, 'snapshot total covers full history';
is ([+] %m<series>.map(*.<snapshots>)), 2, 'window excludes old snapshots';
is ([+] %m<series>.map(*.<retries>)), 1, 'retry transition is counted once despite later controls and snapshot';
is %m<totals><retries>, 3, 'saga retry and command additional attempts are counted once';
is %m<totals><failures>, 1, 'failed commands are counted separately from saga outcomes';
is %m<totals><saga-failures>, 1, 'final saga failure is counted';
is %m<totals><pending>, 1, 'pending backlog';
is %m<totals><processing>, 1, 'processing backlog';
is %m<totals><blocked>, 1, 'blocked saga actions';
is %m<mean-events-per-entity>, 1, 'average domain events per identified owning stream';
my %account = %m<entities>.first(*.<stream> eq 'account/a');
is %account<events-since-snapshot>, 1, 'own-stream snapshot gap';
is %account<snapshots-per-minute>, 1/3, 'per-entity snapshot frequency uses the selected window';
is %account<failure-percent>, 100/3, 'failure rate denominator is submitted commands';
my $html = metrics-view(%m, :sort<failures>);
ok $html.contains('role="img"'), 'graphs expose accessible SVGs';
ok $html.contains('Saga retries / minute'), 'retry chart exists';
ok $html.contains('Failures by entity'), 'entity failure chart exists';
ok $html.contains('Snapshots / minute'), 'snapshot chart exists';
ok $html.contains('snapshot-only history'), 'timing limits are disclosed';
dies-ok { store-metrics(:minutes(0)) }, 'zero-minute window rejected';
dies-ok { store-metrics(:minutes(1441)) }, 'unbounded window rejected';
subtest 'metrics use a replayable projection with a reusable window-independent state' => {
    my $view = metrics-projection();
    ok $view.HOW ~~ Metamodel::RedSourcing::ProjectionHOW, 'ordinary projection metamodel';
    is-deeply $view.report(:@instances, :minutes(3), :$now), %m, 'projection report preserves the public response';
    my $before = $view.^data.raku;
    $view.report(:@instances, :minutes(1), :$now);
    $view.report(:instances([]), :minutes(1440), :now($now.later(:minutes(2))));
    is $view.^data.raku, $before, 'reports do not mutate projected state';
    is-deeply $view.report(:@instances, :minutes(1), :$now),
        store-metrics(:@instances, :minutes(1), :$now), 'one projection serves different time windows';
    $view.^replay;
    is-deeply $view.report(:@instances, :minutes(3), :$now), %m, 'repeated advancement does not double count';

    my $bounded = $view.WHAT.^restore-state(Nil, :stream<bounded-metrics>);
    $bounded.^apply-new-applyable-events(:through-id(4));
    is $bounded.^current-id, 4, 'source honors the upper replay bound';
    is $bounded.report(:$now)<totals><events>, 2, 'bounded replay counts matching domain records';
    is $bounded.report(:$now)<totals><controls>, 0, 'bounded replay excludes later controls';
    $bounded.^replay;
    is-deeply $bounded.counts, $view.counts, 'incremental replay agrees with full reconstruction';

    my $checkpoint = StoredEvent.new(:id(999), :class($view.^name), :mro('|Entity|'),
        :stream<restored-metrics>, :version(1), :replay-cursor($view.^current-id), :data($view.^data.Hash));
    my $restored = $view.WHAT.^restore-state($checkpoint, :stream<restored-metrics>);
    is-deeply $restored.report(:@instances, :minutes(3), :$now), %m, 'normal projection checkpoint restores metrics';
    emit-row('Deposit', 'account/a', 5, '|Event|', %(amount => 2), 0);
    emit-row('RedSourcing::Saga::StepFailed', 'Saga: id = a', 6, '|RedSourcing::Saga::Control|',
        %(state => state(2, 'blocked'), values => {}, cursor => 2, action-id => 'action/1'), 0);
    $restored.^replay;
    is $restored.report(:$now)<totals><events>, 3, 'checkpoint consumes later records once';
    is $restored.report(:$now)<totals><saga-failures>, 1, 'repeated outcomes remain deduplicated after restoration';
    is-deeply $restored.report(:@instances, :minutes(3), :$now),
        store-metrics(:@instances, :minutes(3), :$now), 'restored incremental projection agrees with full replay';
};

subtest 'command refresh replaces contributions and reads only metric columns' => {
    my $pending = StoredCommand.^all.grep(*.state == StoredCommand::Pending).head;
    my $view = metrics-projection();
    $pending.state = StoredCommand::Done;
    $pending.tries = 2;
    $pending.^save;
    $view.include-command(:id($pending.id), :stream($pending.stream), :state($pending.state.Str), :tries($pending.tries));
    is $view.report(:$now)<totals><commands>, 3, 'updating an existing command adds no submission';
    is $view.report(:$now)<totals><pending>, 0, 'previous pending contribution disappears';
    is $view.report(:$now)<totals><retries>, 4, 'new command attempt replaces its old contribution';
    is-deeply $view.report(:@instances, :minutes(3), :$now),
        store-metrics(:@instances, :minutes(3), :$now), 'fresh report observes mutable command changes';
    my @queries;
    my role MetricQueries {
        multi method prepare(Str $sql, |args) { @queries.push($sql); callsame }
    }
    $*RED-DB does MetricQueries;
    my $fresh = metrics-projection();
    is @queries.elems, 2, 'one journal source and one command metadata read';
    ok @queries.first(*.contains('SELECT id, stream, state, tries FROM red_sourcing_command')).defined,
        'command arguments and results are not fetched';
    @queries = ();
    $fresh.report(:@instances, :minutes(3), :$now);
    $fresh.report(:@instances, :minutes(1), :$now);
    is @queries.elems, 0, 'formatting time windows does not query the store';
    my @rows = $fresh.journal-records(:from-id(1), :through-id(4));
    is-deeply @rows.map(*.id).Array, [2, 3, 4], 'raw source honors both cursor bounds';
    nok @rows[0].data.defined, 'domain payload is not fetched';
    nok (@rows[1].data<amount>:exists), 'snapshot domain values are not fetched';
};
done-testing;
