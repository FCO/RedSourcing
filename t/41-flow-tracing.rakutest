use Test;
use RedSourcing;
use RedSourcing::Flow;
use RedSourcing::Inspector;
use RedSourcing::Web::Flows;
use RedSourcing::Web;
use RedSourcing::Web::HTML;
use Cro::HTTP::Router;
use Cro::HTTP::Request;

class BeginFlow does Event { has Str $.id }
class Credited does Event { has Str $.id; has Int $.amount }
class MailAccepted does Event { has Str $.id }
aggregate FlowAccount {
    has Str $.id is entity-id;
    has Int $.balance = 0;
    method APPLY(Credited $e) { $!balance += $e.amount }
    method credit(Int :$amount = 2) is command { self.credited(:$amount); %(balance => $!balance) }
    method fail is command { self.credited(:amount(99)); die 'Rejected' }
    method delegate(Int :$amount = 3) is command {
        my $child = self.WHAT.^with-ids(:id($.id)).credit(:$amount, :!sync);
        %(queued-id => $child.id)
    }
}
projection FlowBalance {
    has Str $.id is entity-id;
    has Int $.balance = 0;
    method APPLY(Credited $e where { .id eqv $!id }) { $!balance += $e.amount }
}
projection FlowCount {
    has Str $.id is entity-id;
    has UInt $.count = 0;
    method APPLY(Credited $e where { .id eqv $!id }) { $!count++ }
}
projection FlowAudit {
    has Str $.id is entity-id;
    has Array $.amounts = [];
    method APPLY(Credited $e where { .id eqv $!id }) { $!amounts.push($e.amount) }
}
saga FlowWorkflow {
    has Str $.id is entity-id;
    multi method APPLY(BeginFlow $e where { .id eqv $!id }) { }
    multi method REACT(BeginFlow $e where { .id eqv $!id }) { self.credit-account }
    multi method REACT(StepSucceeded $e where { .step eq 'credit-account' }) { self.send-mail }
    multi method REACT(StepSucceeded $e where { .step eq 'send-mail' }) { self.^complete }
    method credit-account { self.^command(FlowAccount, 'credit', \(:amount(2)), :!compensation) }
    method send-mail { self.^service('flow-mail', 'send', \(:id($.id)), :!compensation) }
}
my $*RED-DB;
my $*RED-FALLBACK = False;
my $pg-database = %*ENV<RED_SOURCING_TEST_PG_DATABASE>;
my $pg-admin;
my @pg-schemas;
LEAVE { if $pg-admin.defined { $pg-admin.execute("DROP SCHEMA $_ CASCADE") for @pg-schemas } }
sub fresh {
    if $pg-database.defined {
        die 'Use a simple PostgreSQL test database name' unless $pg-database ~~ /^ <[\w\-]>+ $/;
        require ::('DB::Pg'); require ::('RedSourcing::PgJSON');
        $pg-admin //= ::('DB::Pg').new(:conninfo("dbname=$pg-database"));
        my $schema = 'rs_flow_test_' ~ $*PID ~ '_' ~ @pg-schemas.elems;
        $pg-admin.execute("CREATE SCHEMA $schema"); @pg-schemas.push($schema);
        my $pool = ::('DB::Pg').new(:conninfo("dbname=$pg-database options='-csearch_path=$schema'"),
            :converters(<DateTime UUID Geometric>));
        $*RED-DB = (database 'Pg', :dbh($pool)) but ::('RedSourcing::PgJSON');
    } else { $*RED-DB = database 'SQLite', :database(':memory:'); }
    schema(StoredEvent, StoredCommand).create;
}
subtest 'causality is durable without enabling tracing or creating tracing tables' => {
    fresh;
    nok flow-tracing-enabled, 'read-model flag defaults to disabled';
    my $account = FlowAccount.^with-ids(:id<one>); $account.^create;
    is $account.credit<balance>, 2, 'ordinary command succeeds';
    my $command = StoredCommand.^all.head;
    my $event = StoredEvent.^all.grep(*.class eq Credited.^name).head;
    is $event.command-id, $command.id, 'event stores its command ID even with tracing disabled';
    is-deeply $event.data.Hash, %(id => 'one', amount => 2), 'causality is outside the domain JSON';
    is flow-links(:source-kind<command>, :source($command.id.Str), :target($event.id.Str)).elems,
        1, 'projection reconstructs the exact causal link';
    my $before = StoredEvent.^all.elems;
    my $revision = flow-revision;
    enable-flow-tracing; enable-flow-tracing(:!enabled);
    is flow-links(:source-kind<command>, :source($command.id.Str)).elems, 1,
        'toggling does not erase or stop durable causality';
    is StoredEvent.^all.elems, $before, 'reading the flow does not emit snapshots or telemetry';
    is flow-revision, $revision, 'read-only reconstruction does not change the revision';
    is observed-flow-entities.elems, 0, 'no observation registry is maintained';
};

subtest 'saga commands and provider events retain their action and real sources' => {
    fresh;
    register-service 'flow-mail', -> Str $operation, Capture $args, Str :$idempotency-key! {
        MailAccepted.emit(:stream<flow-provider>, :version(1), :id($args.hash<id>));
        %(accepted => True)
    };
    FlowAccount.^with-ids(:id<one>).^create;
    my $proxy = FlowWorkflow.^with-ids(:id<one>); $proxy.^create;
    my $source = BeginFlow.emit(:stream<source>, :version(1), :id<one>);
    my $saga = $proxy.^advance;
    is $saga.^status, 'completed', 'workflow finishes';
    my $command = StoredCommand.^all.head;
    my $event = StoredEvent.^all.grep(*.class eq Credited.^name).head;
    my $provider = StoredEvent.^all.grep(*.class eq MailAccepted.^name).head;
    is $event.command-id, $command.id, 'command emitted the domain event';
    is $command.action-id, $saga.^state<actions>[0]<id>, 'queued command retains its saga action';
    is $event.action-id, $command.action-id, 'command event also retains the action context';
    is $provider.action-id, $saga.^state<actions>[1]<id>, 'provider event retains its action';
    nok $provider.command-id.defined, 'provider event has no invented command';
    is flow-links(:source-kind<event>, :source($source.id.Str), :target($proxy.^stream-name)).elems,
        1, 'persisted saga control proves source consumption';
    FlowBalance.^with-ids(:id<one>).^load;
    is flow-links(:source-kind<event>, :source($event.id.Str), :target-kind<entity>).elems,
        0, 'ordinary projection replay does not write consumption telemetry';
    my $inspector = RedSourcing::Inspector.new(:stored-only);
    my $before = flow-revision;
    my %flow = flow-report($inspector.report, :stream($proxy.^stream-name));
    ok %flow<available>, 'monitor uses the reconstructed graph';
    ok %flow<nodes>.first(*.<id> eq "event:{$event.id}").defined, 'graph includes command event';
    ok %flow<edges>.first(*.<relation> eq 'continued').defined, 'follow-up action is visible';
    my $node = %flow<nodes>.first(*.<id> eq "event:{$event.id}");
    is $node<at>, $event.created.utc.Str, 'event timestamp comes from the journal';
    is $node<details><payload><amount>, 2, 'event payload is visible';
    my $html = flow-view(%flow, :instances($inspector.report<instances>));
    ok $html.contains('flow-node') && $html.contains('Recorded connections'), 'monitor renders interactive cards';
    my %stages = %flow<nodes>.map({ .<id> => .<stage> }).Hash;
    ok %flow<edges>.map({ %stages{.<target>} > %stages{.<source>} }).all, 'causal columns point forward';
    my %focused = flow-report($inspector.report, :focus('action:' ~ $provider.action-id));
    ok %focused<nodes>.first(*.<id> eq "event:{$provider.id}").defined, 'action focus includes its provider event';
    is flow-revision, $before, 'building the monitor graph is read-only';
    my $http-source = Supplier.new;
    my $routes = route { include monitor => inspector-routes($inspector,
        :updates(-> { Supply.empty }), :operations-url('/monitor/operations')); };
    my $responses = $routes.transformer($http-source.Supply).Channel;
    my $request = Cro::HTTP::Request.new(:method<GET>,
        :target('/monitor/flow-fragment?focus=' ~ query-value('action:' ~ $provider.action-id)));
    $request.append-header('Host', 'localhost'); $http-source.emit($request);
    my $response = $responses.receive;
    my $body = $response.body-byte-stream.list.map(*.decode).join;
    is $response.status, 200, 'monitor HTTP route renders the reconstructed flow';
    ok $body.contains('MailAccepted'), 'action fragment includes its provider event';
    $http-source.done;
};

subtest 'failed commands roll back events and their causal metadata' => {
    fresh;
    my $account = FlowAccount.^with-ids(:id<fail>); $account.^create;
    my $before = flow-links.elems;
    dies-ok { $account.fail }, 'handler rejects the command';
    is flow-links.elems, $before, 'rolled-back events leave no causal links';
    is StoredEvent.^all.grep(*.class eq Credited.^name).elems, 0, 'failed event is absent';
    is StoredCommand.^all.head.state, StoredCommand::Failed, 'command failure remains inspectable';
    my %flow = flow-report(RedSourcing::Inspector.new(:stored-only).report, :stream($account.^stream-name));
    is %flow<nodes>.first(*.<kind> eq 'command')<status>, 'Failed', 'failed command appears in the monitor';
};

subtest 'nested commands retain parent identity without flow writes' => {
    fresh;
    my $account = FlowAccount.^with-ids(:id<nested>); $account.^create;
    ok $account.delegate<queued-id>, 'parent enqueues a child command';
    my @commands = StoredCommand.^all.sort(*.id).Array;
    is @commands[1].parent-command-id, @commands[0].id, 'child stores its parent ID';
    is @commands[1].run<balance>, 3, 'child runs after parent commits';
    my $event = StoredEvent.^all.grep(*.class eq Credited.^name).head;
    is $event.command-id, @commands[1].id, 'event belongs to child command';
    is flow-links(:source-kind<command>, :source(@commands[0].id.Str), :target-kind<command>).elems,
        1, 'parent-child edge is reconstructed';
    is flow-links(:source-kind<command>, :source(@commands[0].id.Str), :target-kind<event>).elems,
        0, 'parent is not the direct emitter';
    my %flow = flow-report(RedSourcing::Inspector.new(:stored-only).report, :stream($account.^stream-name));
    ok %flow<edges>.first({ .<source> eq 'command:' ~ @commands[0].id && .<target> eq 'command:' ~ @commands[1].id }).defined,
        'monitor follows nested commands';
};

subtest 'a queued command restores its action context when run independently' => {
    fresh;
    my $account = FlowAccount.^with-ids(:id<queued>); $account.^create;
    my $command;
    {
        my $*REDSOURCING-ACTION = 'workflow/action/1';
        $command = $account.credit(:!sync);
    }
    is $command.action-id, 'workflow/action/1', 'submission persists the action ID';
    $command.run;
    my $event = StoredEvent.^all.grep(*.class eq Credited.^name).head;
    is $event.action-id, 'workflow/action/1', 'independent execution recovers the stored action';
};

subtest 'rebuild reads unknown event classes and late lower serial IDs' => {
    fresh;
    StoredEvent.^create(:id(20), :class<Unavailable::Event>, :mro('|Event|'), :stream<later>, :version(1), :data{});
    is flow-links.elems, 1, 'raw record projection does not load the event class';
    my $revision = flow-revision;
    StoredEvent.^create(:id(10), :class<Unavailable::Event>, :mro('|Event|'), :stream<earlier>, :version(1), :data{});
    is flow-links.elems, 2, 'rebuild includes an earlier allocated ID committed later';
    isnt flow-revision, $revision, 'revision changes even when the maximum ID does not';
    my $before = StoredEvent.^all.elems;
    is flow-projection().^name, 'RedSourcing::Flow::Projection::FlowProjection', 'read model is a normal projection';
    is StoredEvent.^all.elems, $before, 'rebuild has no database writes';
};
subtest 'hover previews escape user data and bound large payloads' => {
    fresh;
    FlowAccount.^with-ids(:id('<script>alert(1)</script>')).^create;
    my %flow = flow-report(RedSourcing::Inspector.new(:stored-only).report, :internal);
    my $snapshot = %flow<nodes>.first(*.<kind> eq 'snapshot');
    $snapshot<details> = %(payload => %(message => '<img src=x onerror=alert(1)>',
        long => 'z' x 20_000, nested => {a => {b => {c => 'too deep'}}},
        many => [1..20], fields => %(a => 1, b => 2, c => 3, d => 4, e => 5, f => 6, g => 7)));
    my $html = flow-view(%flow);
    nok $html.contains('<script>alert') || $html.contains('<img src=x'), 'untrusted names and payloads never become markup';
    ok $html.contains('&lt;img'), 'payload is visible as escaped text';
    nok $html.contains('z' x 351) || $html.contains('too deep'), 'strings and nesting are bounded';
    ok $html.contains('…'), 'omitted preview data is indicated';
};
done-testing;
