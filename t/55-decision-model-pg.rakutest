use Test;
use File::Temp;
use RedSourcing;
use RedSourcing::Config;
use RedSourcing::Flow;
use lib $?FILE.IO.parent.parent.add('examples/school/lib').Str;
use School;

my $database = %*ENV<RED_SOURCING_TEST_PG_DATABASE>;
unless $database.defined {
    skip 'Set RED_SOURCING_TEST_PG_DATABASE to test independent DCB writers';
    done-testing; exit;
}
die 'Use a simple PostgreSQL database name' unless $database ~~ /^ <[\w\-]>+ $/;
require ::('DB::Pg');
my $admin = ::('DB::Pg').new(:conninfo("dbname=$database"));
my $directory = tempdir.IO;
my $worker = $directory.add('worker.raku');
$worker.spurt(q:to/WORKER/);
use RedSourcing;
use RedSourcing::Config;
use RedSourcing::Flow;
use School;
use DB::Pg;
my ($database, $schema, $id, $barrier) = @*ARGS;
my $*RED-DB = store-driver('Pg', $database, :connection{
    dbh => DB::Pg.new(:conninfo("dbname=$database options='-csearch_path=$schema -cclient_min_messages=warning'"),
        :converters(<DateTime UUID Geometric>))
});
enable-flow-tracing;
if $id eq 'append' {
    StudentRegistered.emit(:student-id($barrier), :name<External>, :stream($barrier), :version(1));
    exit;
}
School::Enrollment.^find_method('student-enrolled').wrap(method (|) {
    my $suffix = $barrier.ends-with('-repeat') ?? '.' ~ $*COMMAND.tries !! '';
    unless ($barrier ~ '.ready' ~ $suffix).IO.e {
        ($barrier ~ '.ready' ~ $suffix).IO.spurt($*COMMAND.tries);
        my $deadline = now + 60;
        until ($barrier ~ '.resume' ~ $suffix).IO.e {
            die 'Decision worker barrier timed out' if now > $deadline;
            await Promise.in(0.02);
        }
    }
    callsame
});
try {
    say StoredCommand.^all.grep(*.id == $id.UInt).head.run;
    CATCH { default { say 'REJECTED: ' ~ .message } }
}
WORKER

my $*RED-DB;
my @schemas;
LEAVE $admin.execute("DROP SCHEMA $_ CASCADE") for @schemas;
my $school = School::App.new;
sub fresh {
    my $schema = 'rs_decision_' ~ $*PID ~ '_' ~ @schemas.elems;
    @schemas.push($schema);
    $admin.execute("CREATE SCHEMA $schema");
    $*RED-DB = store-driver('Pg', $database, :connection{
        dbh => ::('DB::Pg').new(:conninfo("dbname=$database options='-csearch_path=$schema -cclient_min_messages=warning'"),
            :converters(<DateTime UUID Geometric>))
    });
    $school.initialize;
    enable-flow-tracing;
    $schema
}
sub fact(Mu:U $type, Str $stream, UInt $version, *%data) { $type.emit(:$stream, :$version, |%data) }
sub race(Str $schema, $command, &compete, UInt :$attempts = 1 --> Hash) {
    my $barrier = $directory.add("barrier-{$schema}-{$command.id}" ~ ($attempts > 1 ?? '-repeat' !! '')).Str;
    my $process = Proc::Async.new($*EXECUTABLE.Str, '-Ilib', '-Iexamples/school/lib',
        $worker.Str, $database, $schema, $command.id.Str, $barrier);
    my ($out, $err) = '', '';
    $process.stdout.tap(-> $s { $out ~= $s });
    $process.stderr.tap(-> $s { $err ~= $s });
    my $finished = $process.start;
    LEAVE $process.kill if $finished.status ~~ Planned;
    for 1..$attempts -> $attempt {
        my $suffix = $attempts > 1 ?? ".$attempt" !! '';
        my $deadline = now + 60;
        until ($barrier ~ '.ready' ~ $suffix).IO.e {
            die "Decision worker exited: $err" unless $finished.status ~~ Planned;
            die 'Decision worker did not reach barrier' if now > $deadline;
            await Promise.in(0.02);
        }
        compete();
        ($barrier ~ '.resume' ~ $suffix).IO.spurt('resume');
    }
    await Promise.anyof($finished, Promise.in(60));
    die 'Decision worker did not finish' if $finished.status ~~ Planned;
    is (await $finished).exitcode, 0, 'worker completes without a process failure';
    is $err, '', 'no aborted-transaction or lock diagnostics';
    %( :$out, :$err )
}

subtest 'two different enrollment streams compete for the thirtieth seat' => {
    my $schema = fresh;
    fact(ClassCreated, 'class', 1, :class-id<math>, :title<Math>);
    for 1..31 -> $i {
        fact(StudentRegistered, "student-$i", 1, :student-id("s$i"), :name("Student $i"));
        fact(StudentEnrolled, 'seed', $i, :student-id("s$i"), :class-id<math>) if $i <= 29;
    }
    $school.classroom('math').^emit-snapshot;
    my $first = $school.enrollment('s30', 'math').enroll(:!sync);
    $school.enrollment('s31', 'math');
    my %result = race($schema, $first, { ok $school.enroll('s31', 'math'), 'competing command takes last seat' });
    like %result<out>, /'REJECTED: Class already has 30 students'/, 'retry reevaluates the business rule';
    $first.^refresh;
    is $first.tries, 2, 'entire original command ran twice';
    is $first.state.Str, 'Failed', 'business rejection follows the optimistic retry';
    is $school.classroom('math').student-count, 30, 'class capacity is never exceeded';
    nok $school.student('s30').classes<math>:exists, 'losing attempt leaves no enrollment';
    is flow-links(:source-kind<command>, :source($first.id.Str), :target-kind<event>).elems, 0,
        'rejected attempt leaves no event tracing';
};

subtest 'one student competes for a tenth enrollment in two different classes' => {
    my $schema = fresh;
    fact(StudentRegistered, 'student', 1, :student-id<alice>, :name<Alice>);
    for 1..11 -> $i {
        fact(ClassCreated, "class-$i", 1, :class-id("c$i"), :title("Class $i"));
        fact(StudentEnrolled, 'seed', $i, :student-id<alice>, :class-id("c$i")) if $i <= 9;
    }
    $school.student('alice').^emit-snapshot;
    my $first = $school.enrollment('alice', 'c10').enroll(:!sync);
    $school.enrollment('alice', 'c11');
    my %result = race($schema, $first, { ok $school.enroll('alice', 'c11'), 'competitor takes tenth enrollment' });
    like %result<out>, /'REJECTED: Student already participates in 10 classes'/, 'retry reads both models again';
    $first.^refresh;
    is $first.tries, 2, 'the complete command is retried';
    is $school.student('alice').class-count, 10, 'student limit is never exceeded';
    is $school.classroom('c10').student-count, 0, 'rejected class receives no student';
};

subtest 'a competing event outside both queries does not invalidate a decision' => {
    my $schema = fresh;
    fact(StudentRegistered, 'student', 1, :student-id<alice>, :name<Alice>);
    fact(ClassCreated, 'class', 1, :class-id<math>, :title<Math>);
    my $first = $school.enrollment('alice', 'math').enroll(:!sync);
    my %result = race($schema, $first, {
        fact(StudentRegistered, 'unrelated', 1, :student-id<bob>, :name<Bob>);
    });
    is %result<out>, "True\n", 'unrelated event does not conflict';
    $first.^refresh;
    is $first.tries, 1, 'no unnecessary retry';
    is $school.classroom('math').student-count, 1, 'decision commits once';
};
subtest 'empty decisions reject the first matching concurrent event without a command wrapper' => {
    my $schema = fresh;
    my ($exists, $code, $errors);
    throws-like {
        decision-model (StudentClasses) => %(:student-id<new>), -> $view {
            $exists = $view.exists;
            my $p = run $*EXECUTABLE.Str, '-Ilib', '-Iexamples/school/lib',
                $worker.Str, $database, $schema, 'append', 'new', :out, :err;
            $code = $p.exitcode;
            $errors = $p.err.slurp(:close);
            $p.out.slurp(:close);
            StudentRegistered.emit(:student-id<new>, :name<Own>, :stream<loser>, :version(1));
        }
    }, RedSourcing::X::OptimisticLockFailed;
    nok $exists, 'decision initially had no matching event';
    is $code, 0, 'independent append succeeded';
    is $errors, '', 'independent append has no diagnostics';
    is StoredEvent.list-events(:row, :stream<loser>).elems, 0, 'direct call rolls back and propagates conflict';
};

subtest 'repeated real conflicts exhaust the command retry budget without persisting its effects' => {
    my $schema = fresh;
    fact(StudentRegistered, 'student', 1, :student-id<alice>, :name<Alice>);
    fact(ClassCreated, 'class', 1, :class-id<math>, :title<Math>);
    my $first = $school.enrollment('alice', 'math').enroll(:!sync);
    my $version = 0;
    my %result = race($schema, $first, {
        fact(StudentRegistered, 'changes', ++$version, :student-id<alice>, :name("Alice $version"));
    }, :attempts(5));
    like %result<out>, /'REJECTED: Optimistic lock failed: decision model'/, 'exhausted conflict propagates';
    $first.^refresh;
    is $first.tries, 5, 'all five complete command attempts are recorded';
    is $first.state.Str, 'Pending', 'command remains eligible for a later worker';
    nok $first.error.defined, 'contention is not recorded as a terminal business failure';
    is $school.classroom('math').student-count, 0, 'no rejected attempt persists an enrollment';
    is flow-links(:source-kind<command>, :source($first.id.Str), :target-kind<event>).elems, 0,
        'no rejected attempt persists emission tracing';
};
done-testing;
