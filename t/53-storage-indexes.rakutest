use Test;
use File::Temp;
use RedSourcing;
use RedSourcing::Counters;
use Red::DB;
use RedSourcing::Flow;
use RedSourcing::Config;
use DB::Pg;

my $*RED-DB;
my $pg = %*ENV<RED_SOURCING_TEST_PG_DATABASE>;
my $admin;
my $pg-schema = 'rs_indexes_' ~ $*PID;
if $pg.defined {
    die 'Use a simple PostgreSQL test database name' unless $pg ~~ /^ <[\w\-]>+ $/;
    $admin = ::('DB::Pg').new(:conninfo("dbname=$pg"));
    $admin.execute("CREATE SCHEMA $pg-schema");
    $*RED-DB = store-driver('Pg', $pg, :connection{
        dbh => ::('DB::Pg').new(
            :conninfo("dbname=$pg options='-csearch_path=$pg-schema -cclient_min_messages=warning'"),
            :converters(<DateTime UUID Geometric>))
    });
} else {
    $*RED-DB = database('SQLite');
}
LEAVE $admin.execute("DROP SCHEMA $pg-schema CASCADE") if $admin.defined;

sub names(Str $table) { get-RED-DB.indexes-for-table($table).map(*.<name>).sort.Array }
sub drop-index(Str $name) { get-RED-DB.execute('DROP INDEX ' ~ get-RED-DB.table-name-wrapper($name)) }

subtest 'new stores declare query indexes and preserve stream-version uniqueness' => {
    schema(StoredEvent, StoredCommand).create;
    for StoredEvent, StoredCommand -> $type {
        my @actual = names($type.^table);
        for $type.^indexes.grep({ !.inline }) -> $index {
            ok $index.name eq any(@actual), "{$index.name} exists";
        }
        lives-ok { $type.^create-indexes; $type.^create-indexes }, 'index creation is idempotent';
    }
    StoredEvent.^create(:class('IndexFact'), :mro('|IndexFact|'), :stream('indexes'), :version(1), :data{});
    dies-ok {
        StoredEvent.^create(:class('IndexFact'), :mro('|IndexFact|'), :stream('indexes'), :version(1), :data{});
    }, 'stream-version uniqueness is unchanged';
    is StoredEvent.^all.elems, 1, 'existing event survives index initialization';
};

subtest 'existing tables receive missing indexes without changing data' => {
    for StoredEvent, StoredCommand -> $type {
        drop-index($_.name) for $type.^indexes.grep({ !.inline });
        lives-ok { $type.^create-table(:unless-exists); $type.^create-indexes },
            'explicit initialization upgrades an existing table';
        for $type.^indexes.grep({ !.inline }) -> $index {
            ok $index.name eq any(names($type.^table)), 'missing declared index is created';
        }
    }
    is StoredEvent.^all.elems, 1, 'upgrade preserves persisted events';
};

subtest 'tracing needs no auxiliary storage or indexes' => {
    lives-ok { enable-flow-tracing; enable-flow-tracing }, 'read-model enablement is idempotent';
    my $catalog = $pg.defined
        ?? q[SELECT tablename AS name FROM pg_tables WHERE schemaname = current_schema()]
        !! q[SELECT name FROM sqlite_master WHERE type = 'table'];
    my @tables = counter-sql(get-RED-DB, $catalog).map(*.<name>);
    nok @tables.grep(*.starts-with('red_sourcing_flow_')).elems, 'no tracing tables are created';
    is flow-links(:target-kind<event>).elems, 1, 'flow is projected from the existing journal';
};

subtest 'configuration bootstrap upgrades an existing SQLite store' => {
    my $directory = tempdir.IO;
    my $file = $directory.add('store.db').Str;
    my $db = database('SQLite', :database($file));
    {
        my $*RED-DB = $db;
        schema(StoredEvent, StoredCommand).create;
        drop-index($_.name) for StoredEvent.^indexes.grep({ !.inline });
    }
    {
        my $*RED-DB;
        red-sourcing-defaults(:directory($directory), :driver<SQLite>, :database($file));
        red-sourcing-defaults(:directory($directory), :driver<SQLite>, :database($file));
        for StoredEvent.^indexes.grep({ !.inline }) -> $index {
            ok $index.name eq any(names(StoredEvent.^table)), 'bootstrap adds the missing index';
        }
    }
};

done-testing;
