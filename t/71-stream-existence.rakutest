use Test;
use RedSourcing;
use RedSourcing::Config;
use RedSourcing::Storage;
use RedSourcing::Journal;

class ExistenceFact does Event { has Str $.value }
class OtherExistenceFact does Event { has Str $.value }
my $database = %*ENV<RED_SOURCING_TEST_PG_DATABASE>;
my $*RED-DB;
my ($admin, $schema);
LEAVE { $admin.execute("DROP SCHEMA $schema CASCADE") if $admin.defined }
if $database {
    require ::('DB::Pg');
    $admin = ::('DB::Pg').new(:conninfo("dbname=$database"));
    $schema = 'rs_stream_existence_' ~ $*PID;
    $admin.execute("CREATE SCHEMA $schema");
    $*RED-DB = store-driver('Pg', $database, :connection{
        dbh => ::('DB::Pg').new(:conninfo("dbname=$database options='-csearch_path=$schema -cclient_min_messages=warning'"),
            :converters(<DateTime UUID Geometric>)) });
} else { $*RED-DB = store-driver('SQLite', ':memory:') }
schema(StoredEvent, StoredCommand).create;
my %prepares;
my role ObserveExistence {
    multi method prepare(Str $sql, |) {
        %prepares{$sql}++ if $sql.starts-with('SELECT id FROM red_sourcing_event WHERE class = ');
        callsame
    }
}
$*RED-DB does ObserveExistence;
sub exists($class, $stream) { storage-stream-exists(journal-connection(), $class, $stream) }
sub fact($stream) { ExistenceFact.emit(:$stream, :version(1), :value<yes>) }
nok exists(ExistenceFact.^name, 'a'), 'missing stream returns false';
fact('a');
ok exists(ExistenceFact.^name, 'a'), 'append is visible after a negative read';
nok exists(OtherExistenceFact.^name, 'a'), 'same stream with another class does not match';
nok exists(ExistenceFact.^name, 'b'), 'same class with another stream does not match';
fact('b');
ok exists(ExistenceFact.^name, 'b'), 'reused query binds fresh stream';
OtherExistenceFact.emit(:stream<a>, :version(2), :value<other>);
ok exists(OtherExistenceFact.^name, 'a'), 'reused query binds fresh class';
my $quoted = q[student's stream ? $1 ' OR 1=1 --];
fact($quoted);
ok exists(ExistenceFact.^name, $quoted), 'quoted stream is bound as data';
nok exists(q[ExistenceFact' OR 1=1 --], $quoted), 'class cannot change the SQL predicate';
if !$database {
    is %prepares.elems, 1, 'all identities share a single SQL shape';
    is %prepares.values.head, 1, 'SQLite prepares that shape once';
}
dies-ok {
    red-do :transaction, {
        fact('rolled-back');
        ok exists(ExistenceFact.^name, 'rolled-back'), 'read sees its transaction append';
        die 'abort';
    }
}, 'caller transaction rolls back';
nok exists(ExistenceFact.^name, 'rolled-back'), 'positive answer does not outlive rollback';
red-do :transaction, {
    nok exists(ExistenceFact.^name, 'committed'), 'transaction starts without stream';
    fact('committed');
    ok exists(ExistenceFact.^name, 'committed'), 'negative answer does not hide transaction append';
};
ok exists(ExistenceFact.^name, 'committed'), 'commit is visible';
if !$database {
    my $*RED-DB = store-driver('SQLite', ':memory:');
    schema(StoredEvent, StoredCommand).create;
    nok exists(ExistenceFact.^name, 'a'), 'another database has independent existence state';
}
done-testing;
