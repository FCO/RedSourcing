use RedSourcing::Config;
config {
    .driver = 'SQLite'; .database = 'school.db';
    .includes = <lib>; .modules = <School>;
    .flow-tracing = True;
    .monitor: { .host = '127.0.0.1'; .port = 3001; .minutes = 60; .allow-new-store = True }
    .worker: { .limit = 100; .interval = 1; .watch = False }
}
