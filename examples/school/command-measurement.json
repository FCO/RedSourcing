      "rows": 2,
      "execute_ms": 0.1075,
      "sql": "WITH changes(key, definition, increment, expected) AS (VALUES (?,?,CAST(? AS BIGINT),CAST(? AS BIGINT)),(?,?,CAST(? AS BIGINT),CAST(? AS BIGINT))) INSERT INTO red_sourcing_counter (key, definition, version) SELECT key, definition, increment FROM changes WHERE expected IS NULL OR expected = 0 OR EXISTS (SELECT 1 FROM red_sourcing_counter c WHERE c.key = changes.key) ORDER BY key ON CONFLICT (key) DO UPDATE SET version = red_sourcing_counter.version + excluded.version WHERE red_sourcing_counter.definition = excluded.definition AND ((SELECT expected FROM changes WHERE changes.key = excluded.key) IS NULL OR red_sourcing_counter.version = (SELECT expected FROM changes WHERE changes.key = excluded.key)) RETURNING key, definition, version",
      "id": 735,
