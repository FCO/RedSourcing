use RedSourcing::Config;

# Paths are relative to this configuration, including when selected with -f.
config {
    .flow-tracing = True;
    .driver = 'Pg';
    .database = %*ENV<PGDATABASE> // 'hearth';
    .connection = %(host => %*ENV<PGHOST> // '127.0.0.1',
        port => (%*ENV<PGPORT> // '5432').Int,
        user => %*ENV<PGUSER> // %*ENV<USER> // 'postgres');
    .includes = <lib>;
    .modules = <Estate::Domain>;

    .monitor: {
        .host = '127.0.0.1';
        .port = 3001;
        .minutes = 60;
        .app-url = 'http://127.0.0.1:3000/';
        # Opening a new store does not create tables; run init explicitly.
        .allow-new-store = True;
    }
    .worker: {
        .limit = 100;
        .interval = 1;
        .watch = False;
    }
}
